<!--
  GetDeployment Policy
  
  Returns model details for a specific deployment.
  Foundry calls this to validate a model exists.
  
  Each model advertised by list-deployments.xml must have a matching branch here,
  otherwise Foundry resolves it to the wrong model or accepts a model that the
  backend cannot serve. Unknown names return 404 so validation fails cleanly.
-->
<policies>
    <inbound>
        <base />
        <choose>
            <when condition="@(context.Request.MatchedParameters[&quot;deploymentName&quot;] == &quot;gpt-4.1&quot;)">
                <return-response>
                    <set-status code="200" reason="OK" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"name": "gpt-4.1", "properties": {"model": {"format": "OpenAI", "name": "gpt-4.1", "version": ""}}}</set-body>
                </return-response>
            </when>
            <when condition="@(context.Request.MatchedParameters[&quot;deploymentName&quot;] == &quot;gpt-5&quot;)">
                <return-response>
                    <set-status code="200" reason="OK" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"name": "gpt-5", "properties": {"model": {"format": "OpenAI", "name": "gpt-5", "version": ""}}}</set-body>
                </return-response>
            </when>
            <otherwise>
                <return-response>
                    <set-status code="404" reason="Not Found" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"error": {"code": "DeploymentNotFound", "message": "The requested deployment does not exist."}}</set-body>
                </return-response>
            </otherwise>
        </choose>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
